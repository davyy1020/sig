[Unit]
Description=SIG Kiosk Web Server & Gimbal Controller
After=network.target multi-user.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/orangepi/sig/ui
ExecStartPre=/bin/bash -c "chmod 666 /dev/i2c* /dev/video* || true"
ExecStart=/usr/bin/python3 /home/orangepi/sig/ui/app.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
